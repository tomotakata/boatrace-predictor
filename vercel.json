{
  "version": 2,
  "builds": [
    {"src": "api/index.py", "use": "@vercel/python", "config": {"maxLambdaSize": "50mb", "maxDuration": 60}},
    {"src": "frontend/package.json", "use": "@vercel/static-build", "config": {"distDir": "dist"}}
  ],
  "routes": [
    {"src": "/api/(.*)", "dest": "api/index.py"},
    {"src": "/assets/(.*)", "dest": "frontend/assets/$1"},
    {"src": "/(favicon\\.ico|robots\\.txt|manifest\\.json|vite\\.svg|favicon\\.svg)", "dest": "frontend/$1"},
    {"src": "/(.*)", "dest": "frontend/index.html"}
  ]
}
